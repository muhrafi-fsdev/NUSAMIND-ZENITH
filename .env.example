AI_PROVIDER=ollama
AI_DEFAULT_MODE=auto
AI_MAX_STEPS=10
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=5200
AI_MEMORY_ENABLED=true
AI_ENABLE_TOOLS=true
AI_ENABLE_STREAMING=true
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_HEAVY_CODER_MODEL=qwen3-coder:30b
NUSAMIND_HEAVY_CODER_ENABLED=false
OLLAMA_THINKING_MODE=auto
OLLAMA_NUM_CTX=16384
OLLAMA_CODER_NUM_CTX=12288
OLLAMA_PROBE_TIMEOUT_MS=1400
OLLAMA_PROBE_CACHE_MS=5000
ADMIN_TOKEN=change-this-local-admin-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional Quran Database Guard V13.12 (Laragon/MySQL)
# Jika database Al-Qur'an kamu sudah ada di MySQL Laragon, aktifkan ini.
# Kalau tidak aktif, sistem otomatis fallback ke data/quran-static.json.
QURAN_SOURCE=auto
QURAN_DB_ENABLED=false
QURAN_DB_HOST=127.0.0.1
QURAN_DB_PORT=3306
QURAN_DB_USER=root
QURAN_DB_PASSWORD=
QURAN_DB_NAME=nusamind_ai
QURAN_DB_TABLE=quran_ayahs
QURAN_DB_SURAH_COLUMN=suraId
QURAN_DB_AYAH_COLUMN=verseID
QURAN_DB_ARABIC_COLUMN=ayahText
QURAN_DB_LATIN_COLUMN=readText
QURAN_DB_TRANSLATION_COLUMN=indoText

# NusaMind V13.20 Edition Profile
NUSAMIND_EDITION=zenith
NUSAMIND_EDITION_NAME=NusaMind Zenith
AI_DEFAULT_INTELLIGENCE_LEVEL=high

AI_ANSWER_MODE=direct-first
AI_RAG_ROUTER=domain-fast
AI_SINGLE_ACCURACY=true

# Desktop agent (disabled by default)
DESKTOP_CONTROL_ENABLED=false
DESKTOP_CONTROL_TOKEN=change-this-local-token
DESKTOP_ALLOWED_ROOTS=C:\laragon\www\nusamind-zenith
# NusaMind Apex Coding Agent R13.39
CODING_AGENT_ENABLED=true
CODING_AGENT_CONFIRMATION_REQUIRED=true
CODING_AGENT_WORKSPACE=C:\laragon\www\nusamind-workspace
CODING_AGENT_TOKEN=
CODING_AGENT_TIER=zenith
CODING_AGENT_MAX_FILES=60
CODING_AGENT_MAX_STEPS=10

# R13.34 core
NUSAMIND_TOOLS_V2=true
NUSAMIND_AGENT_V2=true
NUSAMIND_SQLITE_V2=true
NUSAMIND_ARTIFACT_V2=true
NUSAMIND_RETRIEVAL_V2=true
NUSAMIND_EVIDENCE_V2=true
NUSAMIND_EVALUATOR_V2=true
NUSAMIND_VISION_V1=true
NUSAMIND_TRACE_V2=true
NUSAMIND_PERMISSION_V2=true
NUSAMIND_MAX_AGENT_STEPS=12

# R13.36 customer service
NUSAMIND_CS_ENABLED=true
NUSAMIND_CS_INTERNAL=false
NUSAMIND_CS_PII_MASK=true
NUSAMIND_CS_WRITE_ACTIONS=false
NUSAMIND_CS_AUDIT=true
NUSAMIND_CS_HANDOFF=true

# R13.36 insurance finance
NUSAMIND_INS_FIN_ENABLED=true
NUSAMIND_INS_FIN_EVIDENCE=true
NUSAMIND_INS_FIN_MAX_SCENARIOS=8
NUSAMIND_INS_FIN_MAX_WORKBOOKS=10
NUSAMIND_INS_FIN_REQUIRE_VERIFICATION=true
NUSAMIND_INS_FIN_ALLOW_OFFICIAL_DECISION=false


# R13.37 religion and Quran
RELIGION_MODE_ENABLED=true
RELIGION_CANONICAL_QURAN_ONLY=true
RELIGION_HUMAN_HANDOFF=true
NUSAMIND_EDITION_DESCRIPTION=Expert research and coding agent dengan multi-hop retrieval, evidence graph, transactional workflow, replay, dan patch rollback.
NUSAMIND_DB_FILE=storage/nusamind.db
NUSAMIND_DB_WAL=true
NUSAMIND_SCHEMA_VERSION=3
RETRIEVAL_ENGINE=hybrid-v3
RETRIEVAL_FTS5=true
OCR_LANG=eng

# R13.39 security, upload, retrieval, formula renderer
NUSAMIND_SECURITY_TOKEN=change-this-local-token
NUSAMIND_UPLOAD_PRIVATE_DEFAULT=false
NUSAMIND_UPLOAD_QUARANTINE=true
OLLAMA_EMBED_MODEL=nomic-embed-text
NUSAMIND_FORMULA_RENDERER=plain-text
NUSAMIND_FINAL_ANSWER_FIRST=true
# R13.42 Knowledge Center
KNOWLEDGE_CENTER_ENABLED=true
KNOWLEDGE_CONTROL_TOKEN=
KNOWLEDGE_IMPORT_MAX_RECORDS=1000

# R13.43 Python Machine Learning Service
NUSAMIND_ML_ENABLED=true
NUSAMIND_ML_URL=http://127.0.0.1:8000
NUSAMIND_ML_TIMEOUT_MS=1600
NUSAMIND_ML_MIN_CONFIDENCE=0.74
NUSAMIND_ML_EVAL_ENABLED=true
NUSAMIND_ML_TOKEN=change-this-local-ml-token
NUSAMIND_ML_ALLOW_UNAUTH_WRITE=false
ML_USE_TRANSFORMERS=true
ML_EMBED_MODEL=intfloat/multilingual-e5-base

# R13.44 calibrated ML, neural lab, health intelligence
NUSAMIND_ML_MIN_CONFIDENCE=0.68
NUSAMIND_ML_OOD_ENABLED=true
NUSAMIND_RETRIEVAL_VERSION=v5
NUSAMIND_NEURAL_ENABLED=true
NUSAMIND_HEALTH_ENABLED=true
NUSAMIND_HEALTH_PRIVATE_SESSION=true
NUSAMIND_HEALTH_ALLOW_DIAGNOSIS=false

NUSAMIND_PROMPT_TRACE=true
NUSAMIND_PROMPT_CANARY=false
NUSAMIND_MAX_AGENT_STEPS=8

# R13.47 runtime flags
NUSAMIND_R1347=true
EXTERNAL_CONTEXT_AUTHORITY=none
STORE_RAW_CHAIN_OF_THOUGHT=false
MULTIMODAL_LIVE_MODEL=false
# R13.49.1 Defensive Cybersecurity
NUSAMIND_CYBER_MODE=defensive
NUSAMIND_ACTIVE_ASSET_VALIDATION=false

# N1.2 Advanced Autonomy & Deployment
AUTONOMY_AGENT_TOKEN=change-this-local-autonomy-token
# Generate with PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
NUSAMIND_VAULT_KEY=
NUSAMIND_AUTONOMY_AUDIT=true
NUSAMIND_RAW_SHELL=false
NUSAMIND_FORCE_PUSH_MODE=force-with-lease
NUSAMIND_MCP_QUARANTINE=true
NUSAMIND_DEPLOYMENT_ROLLBACK=true

# N1.3 Answer Quality
NUSAMIND_ANSWER_DEPTH=auto
NUSAMIND_CODE_EXAMPLES=true
NUSAMIND_RAW_LATEX=false

# N1.4 Adaptive Qwen3 Model Runtime
NUSAMIND_RELEASE=N1.5.1
# Heavy coder tidak ditarik/diaktifkan otomatis karena kebutuhan resource tinggi.
