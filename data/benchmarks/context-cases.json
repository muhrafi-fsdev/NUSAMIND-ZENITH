  "recall": {
    "corpus": [
      {
        "role": "user",
        "content": "Bagaimana setting timeout pada ingress kubernetes agar tidak 504?"
      },
      {
        "role": "assistant",
        "content": "Atur annotation proxy-read-timeout di ingress kubernetes menjadi 120 detik, lalu apply ulang manifest."
      },
      {
        "role": "user",
        "content": "Resep rendang daging sapi yang empuk dan bumbu lengkap"
      },
      {
        "role": "assistant",
        "content": "Rendang butuh santan, cabai, lengkuas, dan dimasak sekitar empat jam sampai kering."
      },
      {
        "role": "user",
        "content": "Jadwal olahraga mingguan untuk pemula"
      }
    ],
    "queries": [
      {
        "q": "timeout ingress kubernetes",
        "hits": 2,
        "mustContainAny": [
          "kubernetes"
        ],
        "mustNotContain": [
          "rendang",
          "olahraga"
        ]
      },
      {
        "q": "kubernetes",
        "hits": 2,
        "mustContainAny": [
          "kubernetes"
        ],
        "mustNotContain": [
          "rendang"
        ]
      },
      {
        "q": "resep rendang",
        "hits": 2,
        "mustContainAny": [
          "rendang"
        ],
        "mustNotContain": [
          "kubernetes"
        ]
      },
      {
        "q": "cuaca hari ini bandung",
        "hits": 0
      },
      {
        "q": "jadwal kereta jakarta bandung",
        "hits": 0,
        "note": "hanya 1 dari 4 kata ('jadwal') cocok; syarat minimal ceil(4/2)=2"
      },
      {
        "q": "jadwal olahraga bandung kota",
        "hits": 1,
        "mustContainAny": [
          "olahraga"
        ],
        "mustNotContain": [
          "kubernetes",
          "rendang"
        ],
        "note": "2 dari 4 kata cocok ('jadwal','olahraga') -> memenuhi ceil(4/2)=2"
      },
      {
        "q": "sebuah kata yang tidak ada",
        "hits": 0
      },
      {
        "q": "",
        "hits": 0
      }
    ]
  },
  "configProfiles": [
    {
      "id": "default-is-4gb",
      "env": {},
      "expect": {
        "name": "4gb",
        "ollamaModel": "qwen3:1.7b",
        "ollamaCoderModel": "qwen2.5-coder:1.5b",
        "ollamaFallbackModel": "qwen3:0.6b",
        "ollamaContextWindow": 4096,
        "ollamaCoderContextWindow": 4096,
        "ollamaThinkingMode": "off",
        "maxSteps": 3,
        "toolsEnabled": false,
        "maxOutputTokens": 1024
      }
    },
    {
      "id": "16gb-restores-n14-behaviour",
      "env": {
        "NUSAMIND_HARDWARE_PROFILE": "16gb"
      },
      "expect": {
        "name": "16gb",
        "ollamaModel": "qwen3:8b",
        "ollamaCoderModel": "qwen2.5-coder:7b",
        "ollamaFallbackModel": "qwen2.5:7b",
        "ollamaContextWindow": 16384,
        "ollamaCoderContextWindow": 12288,
        "ollamaThinkingMode": "auto",
        "maxSteps": 10,
        "toolsEnabled": true,
        "maxOutputTokens": 5200
      }
    },
    {
      "id": "8gb",
      "env": {
        "NUSAMIND_HARDWARE_PROFILE": "8gb"
      },
      "expect": {
        "name": "8gb",
        "ollamaModel": "qwen3:4b-q4_K_M",
        "ollamaContextWindow": 8192,
        "toolsEnabled": true
      }
    },
    {
      "id": "env-overrides-model",
      "env": {
        "OLLAMA_MODEL": "custom:1b"
      },
      "expect": {
        "name": "4gb",
        "ollamaModel": "custom:1b",
        "ollamaContextWindow": 4096
      }
    },
    {
      "id": "env-overrides-context",
      "env": {
        "OLLAMA_NUM_CTX": "2048"
      },
      "expect": {
        "ollamaContextWindow": 2048
      }
    },
    {
      "id": "env-enables-tools-on-4gb",
      "env": {
        "AI_ENABLE_TOOLS": "true"
      },
      "expect": {
        "toolsEnabled": true
      }
    },
    {
      "id": "env-disables-tools-on-16gb",
      "env": {
        "NUSAMIND_HARDWARE_PROFILE": "16gb",
        "AI_ENABLE_TOOLS": "false"
      },
      "expect": {
        "toolsEnabled": false
      }
    },
    {
      "id": "unknown-profile-falls-back-with-warning",
      "env": {
        "NUSAMIND_HARDWARE_PROFILE": "xyz"
      },
      "expect": {
        "name": "4gb",
        "warning": true
      }
    }
