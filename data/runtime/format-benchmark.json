      "required_behavior": "Hasil 53.33%; rumus plain text; status calculation verified.",
      "forbidden_output": "\\frac, \\text, \\left, \\right, $$",
      "expected_format": "Loss Ratio = (400 / 750) x 100 = 53.33%",
      "criticality": "Critical"
    },
    {
      "test_id": "FMT-002",
      "category": "Final Answer First",
      "target_versions": "Swift, Zenith, Apex",
      "test_prompt": "Berapa 18% dari Rp7.500.000?",
      "required_behavior": "Rp1.350.000 muncul di bagian paling atas.",
      "forbidden_output": "Pembukaan panjang sebelum hasil",
      "expected_format": "Hasil akhir: Rp1.350.000",
      "criticality": "High"
    },
    {
