{
  "release": "R13.36",
  "scope": "customer-service-and-insurance-finance",
  "principles": [
    "policy-specific facts require source",
    "no final claim decision",
    "verify identity before personal data",
    "mask sensitive fields",
    "handoff on request/critical case",
    "financial calculations use deterministic formulas",
    "separate evidence, assumptions, formula, result, and confidence",
    "never invent premium rate, deductible, policy limit, reserve, treaty, or capital data",
